# Cadena de conexión de Neon (Connection string, con sslmode=require)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require
# Texto largo y aleatorio (mínimo 32 caracteres) para firmar las sesiones
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-123456
# Credenciales del administrador (NO están en el código)
ADMIN_USER=Jefry
ADMIN_PASS=pon-aqui-la-contraseña-del-admin
